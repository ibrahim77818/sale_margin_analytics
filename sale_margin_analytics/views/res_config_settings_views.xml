<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_sma" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.sale_margin_analytics</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <!-- v17 settings layout: <app> / <block> / <setting> -->
            <xpath expr="//app[@name='sale_management']" position="inside">
                <block title="Margin Analytics" name="sma_settings_container">
                    <setting id="sma_cost_method_setting"
                             string="Margin Cost Basis"
                             help="Which cost is used to compute sales margins for this company.">
                        <field name="sma_cost_method" widget="radio" class="o_light_label"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
